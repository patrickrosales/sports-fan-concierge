# Copy to .env and fill in your key.
# The Anthropic API key is used by the backend only; it never reaches the browser.
ANTHROPIC_API_KEY=

# Optional: set to trace the agent runs (prompts, tool calls, token usage) to Logfire.
# Create a project + write token at https://logfire.pydantic.dev. Leave blank to disable
# (the app runs unchanged with no token).
LOGFIRE_TOKEN=
